<file path="Business/Concrete/StatisticsManager.cs">
using Business.Abstract;
using Microsoft.EntityFrameworkCore;
using Repositories; // DbContext'inin olduğu namespace
using System.Linq;
using System.Threading.Tasks;

namespace Business.Concrete
{
    public class StatisticsManager : IStatisticsService
    {
        private readonly RealEstateContext _context; // Generic Repo yerine direkt DbContext!

        public StatisticsManager(RealEstateContext context)
        {
            _context = context;
        }

        public async Task<int> CategoryCountAsync()
        {
            // 🌟 Veriyi RAM'e çekmez, SQL'de "SELECT COUNT(*) FROM Categories" çalıştırır. (0.01 milisaniye sürer)
            return await _context.Categories.CountAsync();
        }

        public async Task<int> ProductCountAsync()
        {
            // 🌟 SQL'de "SELECT COUNT(*) FROM Products" çalıştırır.
            return await _context.Products.CountAsync();
        }

        public async Task<string> MostExpensiveProductAsync()
        {
            // 🌟 SQL'e der ki: "Fiyata göre tersten sırala, en üsttekinin SADECE Başlığını (Title) bana getir."
            // SELECT TOP 1 Title FROM Products ORDER BY Price DESC
            var expensiveProductTitle = await _context.Products
                .OrderByDescending(x => x.Price)
                .Select(x => x.Title) // Bütün tabloyu değil sadece string başlığı çekiyoruz!
                .FirstOrDefaultAsync();

            return expensiveProductTitle ?? "İlan Yok";
        }

        public async Task<int> ActiveProductCountAsync()
        {
            // Yalnızca Status/IsActive alanı True olanları sayar
            // (Not: Product tablondaki aktiflik kolonunun adı neyse x.Status veya x.IsActive olarak değiştir)
            return await _context.Products.Where(x => x.IsActive == true).CountAsync();
        }

        public async Task<int> TotalMessageCountAsync()
        {
            // Ziyaretçilerden gelen toplam mesaj sayısı
            return await _context.Contacts.CountAsync();
        }

        public async Task<int> TotalUserCountAsync()
        {
            // Identity tablosundaki toplam kayıtlı kullanıcı (AppUser) sayısı
            return await _context.Users.CountAsync();
        }
    }
}
